# Environment variables read by pyrit.prompt_target.OpenAIChatTarget
# (via its base class OpenAITarget, pyrit==1.0.1).
#
# PyRIT does NOT auto-load this file — see README.md "Environment configuration"
# for how to load it. Copy this file to `.env` and fill in real values;
# `.env` is gitignored so secrets never get committed.

# Required. Model name (OpenAI) or deployment name (Azure OpenAI).
# Read via OpenAITarget.model_name_environment_variable.
OPENAI_CHAT_MODEL=gpt-4o

# Required. Base URL of the chat completions endpoint, e.g.
# https://api.openai.com/v1 (OpenAI) or
# https://{resource}.openai.azure.com/openai/v1 (Azure OpenAI).
# Read via OpenAITarget.endpoint_environment_variable.
OPENAI_CHAT_ENDPOINT=https://api.openai.com/v1

# Required for non-Azure endpoints (raises ValueError if unset and the
# endpoint isn't a recognized Azure OpenAI / AI Foundry endpoint, in which
# case Entra ID auth is used instead). Read via
# OpenAITarget.api_key_environment_variable / pyrit.auth.resolve_openai_auth.
OPENAI_CHAT_KEY=sk-placeholder-do-not-commit-real-key

# Optional. JSON object of extra HTTP headers to send with every request.
# Read via OpenAITarget.ADDITIONAL_REQUEST_HEADERS through
# default_values.get_non_required_value; empty/unset means no extra headers.
OPENAI_ADDITIONAL_REQUEST_HEADERS={}

# Required for the Anthropic comparison target. Unlike the OPENAI_CHAT_*
# vars above, PyRIT does not read this one automatically — our own adapter
# code must load it (e.g. os.environ["ANTHROPIC_API_KEY"]) and pass it
# explicitly to OpenAIChatTarget(api_key=..., endpoint="https://api.anthropic.com/v1",
# model_name="claude-...") — Anthropic's OpenAI-compatible endpoint, per
# OpenAITarget's supported-provider docstring (openai_target.py:344).
ANTHROPIC_API_KEY=sk-ant-placeholder-do-not-commit-real-key

# Required for the Anthropic comparison target. The Claude model id to send
# via the OpenAI-compatible endpoint (e.g. "claude-sonnet-4-5"). Also read
# manually by our own code, not by PyRIT — set it to whatever model your
# Anthropic account/plan has access to.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Required for the Grok comparison target. Same pattern as Anthropic above —
# xAI exposes an OpenAI-compatible endpoint, so our own code loads this key
# and passes it explicitly to OpenAIChatTarget(api_key=..., endpoint=GROK_ENDPOINT,
# model_name=GROK_MODEL). PyRIT does not read this automatically.
GROK_API_KEY=xai-placeholder-do-not-commit-real-key

# Required for the Grok comparison target. xAI's OpenAI-compatible base URL.
GROK_ENDPOINT=https://api.x.ai/v1

# Required for the Grok comparison target. The Grok model id to send (e.g.
# "grok-4"). Set it to whatever model your xAI account/plan has access to.
GROK_MODEL=grok-4

# Required for the Gemini comparison target. Same pattern as Anthropic/Grok
# above — Google exposes an OpenAI-compatible endpoint, so our own code loads
# this key and passes it explicitly to OpenAIChatTarget(api_key=...,
# endpoint=GEMINI_ENDPOINT, model_name=GEMINI_MODEL). PyRIT does not read
# this automatically.
GEMINI_API_KEY=placeholder-do-not-commit-real-key

# Required for the Gemini comparison target. Google's OpenAI-compatible base URL.
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/

# Required for the Gemini comparison target. The Gemini model id to send
# (e.g. "gemini-3.6-flash"). Set it to whatever model your Google AI
# account/plan has access to — note that Pro-tier models may return a
# permanent 0-quota 429 on a free-tier key/project; Flash models are
# typically free-tier-available.
GEMINI_MODEL=gemini-3.6-flash

# Required for tests/test_rekognition_celebrity.py (scorers/rekognition_celebrity_scorer.py).
# Standard boto3 credential chain — any source boto3 accepts works (env vars,
# ~/.aws/credentials, an IAM role). The principal needs
# rekognition:RecognizeCelebrities. GEMINI_API_KEY above is also required
# unless you pass --image to score an existing image only.
AWS_ACCESS_KEY_ID=placeholder-do-not-commit-real-key
AWS_SECRET_ACCESS_KEY=placeholder-do-not-commit-real-key
AWS_REGION=us-east-1
